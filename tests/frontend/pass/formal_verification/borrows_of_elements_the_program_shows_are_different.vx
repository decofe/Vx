// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// `&mut arr[i]` and `&mut arr[j]` can be held together when the program shows `i != j`: by an
// `if`, by the ranges of the loops around them, or because the indices differ by a constant.
// The prover answers "can the two indices be equal?" from what is known at that point.
//
// borrows_of_elements_that_may_be_the_same.vx has the cases that stay refused.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

fn checked_by_an_if(i : i32, j : i32) -> i32 {
  let mut arr = Tensor<i32>([8]);
  if i != j {
    let x = &mut arr[i];
    let y = &mut arr[j];
    *x = 1;
    *y = 2;
  }
  return arr[0];
}

fn every_pair(n : i32) -> i32 {
  let mut arr = Tensor<i32>([8]);
  for i in 0..n {
    for j in (i + 1)..n {
      let x = &mut arr[i];
      let y = &mut arr[j];
      *x = *x + 1;
      *y = *y + 1;
    }
  }
  return arr[0];
}

fn neighbours(i : i32) -> i32 {
  let mut arr = Tensor<i32>([8]);
  let x = &mut arr[i];
  let y = &mut arr[i + 1];
  *x = 1;
  *y = 2;
  return arr[0];
}

// A constant index against a variable one.
fn past_the_first(i : i32) -> i32 {
  let mut arr = Tensor<i32>([8]);
  if i > 0 {
    let first = &mut arr[0];
    let other = &mut arr[i];
    *first = 1;
    *other = 2;
  }
  return arr[0];
}

// Reading another element while one is borrowed `&mut`.
fn read_another(i : i32, j : i32) -> i32 {
  let mut arr = Tensor<i32>([8]);
  if i < j {
    let x = &mut arr[i];
    let v = arr[j];
    *x = v + 1;
  }
  return arr[0];
}

fn main() -> i32 {
  return checked_by_an_if(1, 2) + every_pair(4) + neighbours(3) + past_the_first(2)
  + read_another(1, 2);
}
