// RUN: not vxc %s 2>&1 | FileCheck %s '--implicit-check-not=Error['
//
// Calling an `unsafe fn` needs an `unsafe` block, however it is called: through its type's
// name, `Cell::make(1)`, generic or not, and a generic one on every call, not only the
// first. Inside an `unsafe` block the same calls are fine.

struct Cell {
  v : i32,
}

impl Cell {
  unsafe fn make(v : i32) -> Cell {
    return Cell {
      v: v
    };
  }

  unsafe fn wrap<T>(x : T) -> T {
    return x;
  }
}

unsafe fn first<T>(x : T) -> T {
  return x;
}

fn main() -> i32 {
  // CHECK: Error[E5001] at [[@LINE+1]]:{{.*}}'Cell::make'
  let a = Cell::make(1);
  // CHECK: Error[E5001] at [[@LINE+1]]:
  let b = first(2);
  // CHECK: Error[E5001] at [[@LINE+1]]:
  let c = first(3);
  // CHECK: Error[E5001] at [[@LINE+1]]:{{.*}}'Cell::wrap'
  let w = Cell::wrap(6);
  let d = unsafe { Cell::make(4) };
  let e = unsafe { first(5) };
  return a.v + b + c + d.v + e + w;
}
