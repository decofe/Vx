//===----------------------------------------------------------------------===//
// A dispatch carries the topology's declared *name*, not only its id (#348).
//
// The id cannot say which declared topology a kernel is for. A GPU declared in a
// machine file (`arch: nvptx64`) is given the id of `Topology::GPU[0]`, 500,
// because the runtime knows a GPU only by that number, so both workers here
// get `topo=500`. The name is what a plugin looks a worker up by in a fleet
// manifest, which is what makes `spawn on(Topology::DecodeWorker)` mean the
// same thing whether the worker is the GPU beside this one or a GPU in another
// rack.
//
// The two workers are declared in this file rather than in a machine file
// passed with `--machine`, which keeps the test self-contained.
//
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s
//
// The id and the name are checked together, as one literal, because the
// pairing is the property. They are written in emission order, which is the
// reverse of source order: the DecodeWorker spawn is second in this file and
// first in the output.
//
// CHECK: \00topo=500\00toponame=DecodeWorker\00
// CHECK: \00topo=500\00toponame=PrefillWorker\00

extern "C" {
  fn vx_alloc_f32(n : i32) -> *mut f32;
}

Memory PREFILL_HBM {
  capacity: 80 GiB, bandwidth: 3.35 TB/s, managed: explicit, scope: device
}

Memory DECODE_HBM {
  capacity: 80 GiB, bandwidth: 3.35 TB/s, managed: explicit, scope: device
}

// CPU_DRAM stays visible to both so the test can spawn over host-allocated
// views without an explicit transfer; the transfer discipline is E6003's
// subject and is exercised elsewhere.
Topology PrefillWorker {
  arch: nvptx64,
  memory: Memory::PREFILL_HBM,
  visible: [Memory::PREFILL_HBM, Memory::CPU_DRAM],
  transfer Memory::CPU_DRAM -> Memory::PREFILL_HBM : 63 GB/s,
  transfer Memory::PREFILL_HBM -> Memory::DECODE_HBM : 50 GB/s
}

Topology DecodeWorker {
  arch: nvptx64,
  memory: Memory::DECODE_HBM,
  visible: [Memory::DECODE_HBM, Memory::CPU_DRAM],
  transfer Memory::CPU_DRAM -> Memory::DECODE_HBM : 63 GB/s,
  transfer Memory::DECODE_HBM -> Memory::PREFILL_HBM : 50 GB/s
}

fn gemm_on_prefill() -> i32 {
  let pw : *mut f32 = unsafe { vx_alloc_f32(4) };
  let px : *mut f32 = unsafe { vx_alloc_f32(2) };
  let py : *mut f32 = unsafe { vx_alloc_f32(2) };
  let w = unsafe { tensor_view_2d(pw, 2, 2) };
  let x = unsafe { tensor_view_2d(px, 2, 1) };
  let mut y = unsafe { tensor_view_2d(py, 2, 1) };
  spawn on(Topology::PrefillWorker) {
    matmul_into(&mut y, &w, &x);
  }
  return 0;
}

fn gemm_on_decode() -> i32 {
  let pw : *mut f32 = unsafe { vx_alloc_f32(4) };
  let px : *mut f32 = unsafe { vx_alloc_f32(2) };
  let py : *mut f32 = unsafe { vx_alloc_f32(2) };
  let w = unsafe { tensor_view_2d(pw, 2, 2) };
  let x = unsafe { tensor_view_2d(px, 2, 1) };
  let mut y = unsafe { tensor_view_2d(py, 2, 1) };
  spawn on(Topology::DecodeWorker) {
    matmul_into(&mut y, &w, &x);
  }
  return 0;
}

fn main() -> i32 {
  let a = gemm_on_prefill();
  let b = gemm_on_decode();
  return a + b;
}
